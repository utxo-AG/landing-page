---
/*
  One run of one agent, readable step by step: a rail of six stations, one pane per station in a fixed
  frame, and the log of the run next to it. Sits on the dark block (the block carries .mock-dark).
  The markup is the reduced-motion and no-JS frame: the run waits at the approval point.
  Props: v = t.servicePages['managed-agents'].run.visual
*/
import { shift } from './model.js';

const { v } = Astro.props;
const STILL = 4;
const LOGGED = 5;
const HOUR = 60;
const number = (i) => String(i + 1).padStart(2, '0');
const total = v.sources.items.reduce((sum, item) => sum + item.count, 0);
const before = v.log.slice(LOGGED).map((row) => ({ time: shift(row.time, -HOUR), text: row.text, old: true }));
const rows = [...before, ...v.log.slice(0, LOGGED)];
const data = JSON.stringify({ log: v.log, number: v.runNumber, counts: v.sources.items.map((item) => item.count), waiting: v.approval.waiting, approved: v.approval.approved });
---
<div class="map-run" data-map-run data-run={data} role="img" aria-label={v.label}>
  <div class="mock-bar label"><span>{v.context} · {v.runLabel} <span data-number>{v.runNumber}</span></span><span class="mock-live"><i></i>{v.live}</span></div>
  <ol class="map-run-rail">
    {v.stations.map((name, i) => (
      <li class:list={[i < STILL && 'is-done', i === STILL && 'is-on']}><i class="map-run-seg"><b></b></i><span class="label"><em>{number(i)}</em>{name}</span></li>
    ))}
  </ol>
  <div class="map-run-main">
    <div class="map-run-panes">
      <div class="map-run-pane" data-pane="trigger">
        <p class="map-run-kicker label" style="--s:0">{v.trigger.kicker}</p>
        <p class="map-run-title" style="--s:1">{v.trigger.title}</p>
        <dl class="map-run-rows">
          {v.trigger.rows.map((row, i) => <div style={`--s:${i + 3}`}><dt>{row.name}</dt><dd>{row.value}</dd></div>)}
        </dl>
      </div>
      <div class="map-run-pane" data-pane="sources">
        <p class="map-run-kicker label" style="--s:0"><span>{v.sources.kicker}</span><span class="map-run-count"><b data-count>{total}</b> {v.sources.of}</span></p>
        <ul class="map-run-src">
          {v.sources.items.map((item, i) => (
            <li style={`--s:${i * 4 + 4}`}>
              <span>{item.name}</span><small>{item.kind}</small><b>{item.count}</b>
              <i class="map-run-fill"><b></b></i>
            </li>
          ))}
        </ul>
        <p class="map-run-note" style={`--s:${v.sources.items.length * 4 + 5}`}>{v.sources.rejected}</p>
      </div>
      <div class="map-run-pane" data-pane="draft">
        <p class="map-run-kicker label" style="--s:0">{v.draft.kicker}</p>
        <p class="map-run-doc" style="--s:1">{v.draft.title}</p>
        <ol class="map-run-doc-rows">
          {v.draft.sections.map((section, i) => (
            <li style={`--s:${i * 4 + 4};--w:${[72, 88, 60, 80, 66][i % 5]}%`}>
              <span>{section.name}</span><i class="map-run-fill"><b></b></i><small>{section.cites}</small>
            </li>
          ))}
        </ol>
      </div>
      <div class="map-run-pane" data-pane="check">
        <p class="map-run-kicker label" style="--s:0"><span>{v.check.kicker}</span><em class="st" style={`--s:${v.check.items.length * 4 + 5}`}>{v.check.passed}</em></p>
        <p class="map-run-title map-run-question" style="--s:1">{v.check.title}</p>
        <ul class="map-run-checks">
          {v.check.items.map((item, i) => <li style={`--s:${i * 4 + 4}`}><i></i><span>{item}</span></li>)}
        </ul>
      </div>
      <div class="map-run-pane is-on" data-pane="approval">
        <p class="map-run-kicker label" style="--s:0"><span>{v.approval.kicker}</span><em class="st is-human" data-gate>{v.approval.waiting}</em></p>
        <p class="map-run-person" style="--s:2"><i>{v.approval.initials}</i><span><b>{v.approval.person}</b><small>{v.approval.role}</small></span></p>
        <p class="map-run-title map-run-question" style="--s:4">{v.approval.question}</p>
        <p class="map-run-actions" style="--s:7"><span class="approve" data-approve>{v.approval.approve}</span><span class="map-run-back">{v.approval.back}</span></p>
      </div>
      <div class="map-run-pane" data-pane="result">
        <p class="map-run-kicker label" style="--s:0"><span>{v.result.kicker}</span><em class="st" style="--s:9">{v.result.done}</em></p>
        <p class="map-run-title map-run-file" style="--s:1">{v.result.title}</p>
        <dl class="map-run-rows">
          {v.result.rows.map((row, i) => <div style={`--s:${i + 3}`}><dt>{row.name}</dt><dd>{row.value}</dd></div>)}
        </dl>
      </div>
    </div>
    <div class="map-run-log">
      <p class="label">{v.logLabel}</p>
      <ol>
        {rows.map((row) => <li class:list={[row.old && 'is-old']}><time>{row.time}</time><span>{row.text}</span></li>)}
      </ol>
    </div>
  </div>
</div>

<script>
  import { run } from './run.js';

  document.querySelectorAll('[data-map-run]').forEach(run);
</script>

<style is:global>
.map-run{--small:max(11px, .82em);--row:clamp(36px, 3.1vw, 46px);font-size:clamp(13px, 1.05vw, 15.5px);line-height:1.3}
.map-run .mock-live i{background:var(--phthalo-lift)}
.map-run .st,.map-run .approve{font-size:var(--small)}
.map-run [data-number]{font-variant-numeric:tabular-nums}

.map-run-rail{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin-top:clamp(18px, 2vw, 30px)}
.map-run-seg{display:block;height:3px;border-radius:3px;background:var(--m-soft);overflow:hidden}
.map-run-seg b{display:block;height:100%;border-radius:3px;background:var(--m-fg);transform-origin:0 50%;transform:scaleX(0)}
.map-run-rail .is-done b{transform:none}
.map-run-rail .is-on b{transform:none;background:var(--phthalo-lift)}
.js .map-run-rail .is-on b{transition:transform var(--dur, 2.4s) linear}
.map-run-rail.is-wipe b{opacity:0;transition:opacity var(--t-move) ease}
.map-run-rail span{display:flex;gap:.7em;margin-top:11px;color:var(--m-muted);transition:color var(--t-fast)}
.map-run-rail em{font-style:normal;opacity:.6}
.map-run-rail .is-on span,.map-run-rail .is-done span{color:var(--m-fg)}

.map-run-main{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,4fr);gap:clamp(22px, 3.4vw, 56px);align-items:start;margin-top:clamp(22px, 2.6vw, 40px)}
.map-run-panes{display:grid;border-radius:16px;background:rgba(238,240,246,.045);box-shadow:inset 0 0 0 1px rgba(238,240,246,.1)}
.map-run-pane{grid-area:1 / 1;display:flex;flex-direction:column;min-width:0;min-height:calc(7 * var(--row) + 1.6em);padding:clamp(18px, 2.2vw, 34px);visibility:hidden;opacity:0}
.map-run-pane.is-on{visibility:visible;opacity:1}
.map-run-kicker{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:2.2em;color:var(--m-muted)}
.map-run-count{color:var(--m-muted);font-variant-numeric:tabular-nums}
.map-run-count b{color:var(--m-fg);font-weight:600}
.map-run-title{margin-top:clamp(10px, 1.2vw, 18px);font-size:clamp(22px, 2.5vw, 38px);line-height:1.05;letter-spacing:-.035em;text-wrap:balance}
.map-run-file{font-size:clamp(18px, 1.9vw, 29px);overflow-wrap:anywhere}
.map-run-rows{margin-top:auto;padding-top:clamp(18px, 2vw, 30px)}
.map-run-rows div{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:16px;padding:.72em 0;border-top:1px solid var(--m-rule)}
.map-run-rows dt{color:var(--m-muted)}
.map-run-rows dd{margin:0}

.map-run-fill{display:block;height:3px;border-radius:3px;background:var(--m-soft);overflow:hidden}
.map-run-fill b{display:block;height:100%;border-radius:3px;background:var(--m-fg);opacity:.7;transform-origin:0 50%}
.map-run-src{margin-top:clamp(10px, 1.2vw, 18px)}
.map-run-src li{display:grid;grid-template-columns:minmax(0,1fr) auto 2ch;gap:8px 16px;align-items:baseline;padding:.62em 0 .7em}
.map-run-src li > span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.map-run-src small{font-size:var(--small);color:var(--m-muted)}
.map-run-src li > b{font-weight:600;text-align:right;font-variant-numeric:tabular-nums}
.map-run-src .map-run-fill{grid-column:1 / -1}
.map-run-note{margin-top:auto;padding-top:.8em;color:var(--m-muted)}

.map-run-doc{margin-top:clamp(10px, 1.2vw, 18px);font-size:1.3em;font-weight:500;letter-spacing:-.02em}
.map-run-doc-rows{margin-top:auto;padding-top:clamp(12px, 1.4vw, 20px)}
.map-run-doc-rows li{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,5fr) minmax(4.6em,auto);gap:16px;align-items:center;padding:.66em 0;border-top:1px solid var(--m-rule)}
.map-run-doc-rows span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.map-run-doc-rows .map-run-fill{width:var(--w)}
.map-run-doc-rows small{font-size:var(--small);color:var(--m-muted);text-align:right;font-variant-numeric:tabular-nums}
.map-run-doc-rows small::before{content:"["}
.map-run-doc-rows small::after{content:"]"}

.map-run-checks{margin-top:auto;padding-top:clamp(12px, 1.4vw, 20px)}
.map-run-checks li{display:flex;align-items:center;gap:14px;padding:.78em 0;border-top:1px solid var(--m-rule)}
.map-run-checks i{position:relative;flex:none;width:1.25em;height:1.25em;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(238,240,246,.3)}
.map-run-checks i::before{content:"";position:absolute;inset:0;border-radius:50%;background:var(--m-fg)}
.map-run-checks i::after{content:"";position:absolute;left:34%;top:20%;width:28%;height:46%;border-right:1.6px solid var(--stage);border-bottom:1.6px solid var(--stage);transform:rotate(42deg)}

.map-run-person{display:flex;align-items:center;gap:12px;margin:clamp(12px, 1.4vw, 20px) 0 clamp(6px, .6vw, 10px)}
.map-run-person i{display:grid;place-items:center;flex:none;width:2.7em;height:2.7em;border-radius:50%;background:var(--m-soft);font-style:normal;font-size:var(--small);font-weight:600;letter-spacing:.04em}
.map-run-person b{display:block;font-weight:600}
.map-run-person small{display:block;font-size:var(--small);color:var(--m-muted)}
.map-run-question{font-size:clamp(20px, 2.1vw, 32px)}
.map-run-actions{display:flex;align-items:center;gap:20px;margin-top:auto;padding-top:clamp(18px, 2vw, 30px)}
.map-run .approve{animation:none;padding:9px 16px}
.map-run-back{font-size:var(--small);font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--m-muted)}
.map-run-pane.is-approved .map-run-actions{opacity:.35;transition:opacity var(--t-fast)}

.map-run-log ol{display:flex;flex-direction:column;justify-content:flex-end;height:calc(7 * var(--row));margin-top:calc(1.6em - 1px);overflow:hidden;border-bottom:1px solid var(--m-rule)}
.map-run-log li{flex:none;display:grid;grid-template-columns:3.4em minmax(0,1fr);gap:14px;align-items:center;height:var(--row);border-top:1px solid var(--m-rule);transition:opacity var(--t-move)}
.map-run-log li.is-old{opacity:.38}
.map-run-log time{color:var(--m-muted);font-variant-numeric:tabular-nums}
.map-run-log li span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.map-run-log > p{color:var(--m-muted);min-height:1.6em}

/* entry of the frame, then of the parts of a pane each time it comes on (order --s, 100 ms apart) */
.js .map-run{opacity:0;transform:translateY(36px);transition:opacity var(--t-move) ease .25s,transform var(--t-enter) var(--ease) .25s}
.js .is-in .map-run{opacity:1;transform:none}
.js .map-run-pane{transition:opacity var(--t-fast) ease,visibility 0s var(--t-fast)}
.js .map-run-pane.is-on{transition:opacity var(--t-fast) ease .2s,visibility 0s .2s}
.js .map-run-pane [style*="--s"]{opacity:0;transform:translateY(10px);transition:opacity 0s .4s,transform 0s .4s}
.js .map-run-pane.is-on [style*="--s"]{opacity:1;transform:none;transition:opacity var(--t-move) ease,transform var(--t-move) var(--ease);transition-delay:calc(200ms + var(--s) * 100ms)}
.js .map-run-pane .map-run-fill b{transform:scaleX(0);transition:transform 0s .4s}
.js .map-run-pane.is-on .map-run-fill b{transform:none;transition:transform var(--t-move) var(--ease);transition-delay:calc(350ms + var(--s) * 100ms)}
.js .map-run-checks i::before,.js .map-run-checks i::after{opacity:0;transition:opacity 0s .4s}
.js .map-run-pane.is-on .map-run-checks i::before,.js .map-run-pane.is-on .map-run-checks i::after{opacity:1;transition:opacity var(--t-fast) ease;transition-delay:calc(500ms + var(--s) * 100ms)}

/* up to 1000px the log sits under the frame and shows its last four rows */
@media (max-width:1000px){
  .map-run{--row:40px;font-size:clamp(13px, 1.8vw, 15px)}
  .map-run-main{grid-template-columns:minmax(0,1fr)}
  .map-run-pane{min-height:0}
  .map-run-log ol{height:calc(4 * var(--row))}
  .map-run-title{font-size:clamp(22px, 4vw, 32px)}
  .map-run-question{font-size:clamp(20px, 3.4vw, 28px)}
  .map-run-file{font-size:clamp(17px, 3vw, 24px)}
}
/* phones: the rail shows only the name of the station that is on */
@media (max-width:760px){
  .map-run{--small:max(10px, .8em)}
  .map-run-rail{position:relative;gap:4px;padding-bottom:calc(11px + 1.4em)}
  .map-run-rail span{position:absolute;left:0;top:3px;visibility:hidden}
  .map-run-rail .is-on span{visibility:visible}
  .map-run-pane{padding:16px}
  .map-run-rows div{grid-template-columns:minmax(0,3fr) minmax(0,5fr);gap:10px}
  .map-run-doc-rows li{grid-template-columns:minmax(0,7fr) minmax(0,3fr) minmax(4.2em,auto);gap:10px}
  .map-run-log li{gap:8px}
}
@media (prefers-reduced-motion:reduce){
  .js .map-run,.js .map-run-pane,.js .map-run-pane [style*="--s"]{transition:none;opacity:1;transform:none}
  .js .map-run-pane:not(.is-on){opacity:0}
  .js .map-run-pane .map-run-fill b{transform:none;transition:none}
  .js .map-run-checks i::before,.js .map-run-checks i::after{opacity:1;transition:none}
}
</style>

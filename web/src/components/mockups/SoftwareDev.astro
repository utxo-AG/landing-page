.sd[data-api="1"] .sd-node--agent > i,.sd[data-api="4"] .sd-node--agent > i,.sd[data-api="2"] .sd-node--fan > i,.sd[data-api="3"] .sd-node--fan > i,.sd[data-api="4"] .sd-node--write > i{background:var(--phthalo-lift)}

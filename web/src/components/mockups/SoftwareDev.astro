---
/*
  Software Development: a product-video style showreel in one dark frame. Five screens with bezels (SCREENS) stand in
  a 3D world; one camera (the transform of .sd-world) moves from shot to shot (SHOTS) and depth of field blurs the
  screens that are out of focus (FOCUS, blur per screen in frame units). All geometry is in frame units
  (1 unit = 1 % of the frame width); a screen in focus is shown at scale 1 in the wide frame, so its text is crisp.
  Two camera sets: the wide frame (16:10) and the narrow one (4:5), where a unit is 2.6 % of the width, so the camera
  sits closer and frames part of a screen at the same scale 1.
  The markup is the still: establishing shot, every screen in its final state (data-chat, data-api, data-dash, data-app, data-note).
*/
const { t } = Astro.props;
const m = t.mockups['software-dev'];

const SCREENS = {
  tablet: { x: -66, y: 8, z: 28, a: 26, w: 68, h: 51, r: 2.6, fs: 1.6 },
  desk: { x: 4, y: -6, z: -30, a: -5, w: 92, h: 57.5, r: 2.2, fs: 1.5 },
  phone: { x: 68, y: 10, z: 40, a: -30, w: 26.5, h: 57.4, r: 4.2, fs: 1.55 },
  phone2: { x: 122, y: -16, z: -30, a: -20, w: 26.5, h: 57.4, r: 4.2, fs: 1.55 },
  api: { x: -100, y: -47, z: -50, a: 16, w: 88, h: 55, r: 2.2, fs: 1.75 },
};
const SHOTS = ['wide', 'chat', 'dash', 'app', 'duo', 'api'];
const FOCUS = ['wide', 'chat', 'dash', 'app', 'duo', 'rack', 'api'];
const BLUR = {
  tablet: [0.22, 0, 0.5, 0.6, 0.6, 0.6, 0.6],
  desk: [0, 0.5, 0, 0.6, 0.6, 0.5, 0.5],
  phone: [0.3, 0.6, 0.5, 0, 0, 0.45, 0.7],
  phone2: [0.5, 0.7, 0.5, 0.55, 0.5, 0, 0.7],
  api: [0.4, 0.7, 0.6, 0.7, 0.7, 0.7, 0],
};
/* camera: [screen or world point, offset on the screen, scale, tilt x, tilt y] */
const WIDE = {
  wide: [[6, -9, 0], [0, 0], 0.43, 9, -6],
  chat: ['tablet', [0, 0], 1.04, 2, 5],
  dash: ['desk', [0, 0], 1, 2, -4],
  app: ['phone', [0, 0], 1, 2, 6],
  duo: [[98, -15.5, -18], [0, 0], 1.08, 3, 12],
  api: ['api', [0, 0], 1, 2, -4],
};
const NARROW = {
  wide: [[0, -6, 0], [0, 0], 0.22, 8, -10],
  chat: ['tablet', [4, 0], 0.95, 2, 4],
  dash: ['desk', [26.5, -3], 1, 2, -3],
  app: ['phone', [0, -4], 0.95, 2, 5],
  duo: [[116, -21, -28], [0, 0], 1.04, 3, 14],
  api: ['api', [14.2, 0], 0.8, 2, -3],
};

const rad = (degrees) => (degrees * Math.PI) / 180;
const fix = (value) => Number(value.toFixed(2));
const point = (screen, [dx, dy]) => [screen.x + dx * Math.cos(rad(screen.a)), screen.y + dy, screen.z - dx * Math.sin(rad(screen.a))];
const move = ([x, y, z]) => `translate3d(calc(${fix(x)} * var(--u)), calc(${fix(y)} * var(--u)), calc(${fix(z)} * var(--u)))`;
const camera = ([target, offset, scale, tiltX, tiltY]) => {
  const screen = SCREENS[target];
  const [x, y, z] = screen ? point(screen, offset) : target;
  return `scale(${scale}) rotateX(${tiltX}deg) rotateY(${tiltY - (screen ? screen.a : 0)}deg) ${move([-x, -y, -z])}`;
};
const cameras = SHOTS.map((shot, k) => `--cam${k}:${camera(WIDE[shot])};--ncam${k}:${camera(NARROW[shot])}`).join(';');
const place = (key, index) => {
  const s = SCREENS[key];
  return `--i:${index};--x:${s.x};--y:${s.y};--z:${s.z};--a:${s.a};--w:${s.w};--h:${s.h};--r:${s.r};--fs:${s.fs};${BLUR[key].map((blur, k) => `--b${k}:${blur}`).join(';')}`;
};
/*
  Data lines. A line never runs over the face of a screen: it leaves the source at its bezel edge and stays in the plane
  of that screen for the first piece, crosses free space, and reaches the target edge inside the plane of the target.
  route: [screen, point on its edge, point beside it in the same plane] for source and target.
*/
const ROUTES = {
  chat: [['tablet', [20, -25.5], [20, -44]], ['api', [44, 11], [50, 11]]],
  api: [['api', [44, 14], [49, 14]], ['desk', [-46, -14], [-51, -14]]],
  app: [['phone', [13.25, -6], [18, -6]], ['phone2', [-13.25, 10], [-18, 10]]],
};
const wires = Object.entries(ROUTES).flatMap(([name, [[from, a, a2], [to, b, b2]]]) => {
  const path = [point(SCREENS[from], a), point(SCREENS[from], a2), point(SCREENS[to], b2), point(SCREENS[to], b)];
  const pieces = path.slice(1).map(([x2, y2, z2], index) => {
    const [x, y, z] = path[index];
    const [dx, dy, dz] = [x2 - x, y2 - y, z2 - z];
    const flat = Math.hypot(dx, dz);
    return { x, y, z, n: Math.hypot(flat, dy), yaw: Math.atan2(-dz, dx) * 180 / Math.PI, pitch: Math.atan2(dy, flat) * 180 / Math.PI };
  });
  const total = pieces.reduce((sum, piece) => sum + piece.n, 0);
  let done = 0;
  return pieces.map((piece) => {
    const style = `--x:${fix(piece.x)};--y:${fix(piece.y)};--z:${fix(piece.z)};--n:${fix(piece.n)};--yaw:${fix(piece.yaw)};--pitch:${fix(piece.pitch)};--d:${fix(done / total)};--t:${fix(piece.n / total)}`;
    done += piece.n;
    return { name, style };
  });
});
const chat = m.chat;
const dash = m.dash;
const app = m.app;
const notes = m.notes;
const api = m.api;

/* API screen: hub and nodes in em of the diagram box; a spoke runs from the hub to each node. "call" names the request a node takes part in. */
const HUB = { x: 22.5, y: 8.5, w: 8.4, h: 4 };
const NODES = [
  { key: 'agent', x: 6.5, y: 8.5, w: 10.4, h: 3.8, call: 'agent' },
  { key: 'erp', x: 39.5, y: 2.2, w: 11.4, h: 3.6, call: 'fan' },
  { key: 'files', x: 39.5, y: 8.5, w: 11.4, h: 3.6, call: 'fan' },
  { key: 'crm', x: 39.5, y: 14.8, w: 11.4, h: 3.6, call: 'write' },
  { key: 'sso', x: 22.5, y: 2, w: 9, h: 3.4 },
  { key: 'mail', x: 22.5, y: 15, w: 9, h: 3.4 },
];
const box = (node) => `--x:${node.x};--y:${node.y};--w:${node.w};--h:${node.h}`;
const spoke = (node) => `--len:${fix(Math.hypot(node.x - HUB.x, node.y - HUB.y))};--ang:${fix(Math.atan2(node.y - HUB.y, node.x - HUB.x) * 180 / Math.PI)}`;
const LOG_AFTER = ['', 'fan', 'fan', 'write'];
---
<div class="sd" data-mockup="software-dev" data-shot="wide" data-focus="wide" data-chat="4" data-api="5" data-dash="3" data-app="2" data-note="1" data-wire="">
  <div class="sd-frame stage-dark mock-dark">
    <div class="sd-drift">
      <div class="sd-world" style={cameras}>
        <div class="sd-screen" style={place('tablet', 0)}>
          <div class="sd-ui sd-chat">
            <div class="sd-rail">
              <b>{chat.workspace}</b>
              <small>{chat.channelsLabel}</small>
              <ul>{chat.channels.map((name) => <li class:list={[name === chat.channel && 'is-active']}>{name}</li>)}</ul>
              <small>{chat.agentsLabel}</small>
              <p class="sd-agent"><i></i>{chat.agent}</p>
            </div>
            <div class="sd-room">
              <p class="sd-room-head"><b>{chat.channel}</b><small>{chat.members}</small></p>
              <div class="sd-thread">
                <div class="sd-msgs">
                  {chat.messages.map((message) => (
                    <div class="sd-msg"><i>{message.initials}</i><p><b>{message.name}</b><small>{message.time}</small></p><p>{message.text}</p></div>
                  ))}
                  <div class="sd-msg sd-msg--ask"><i>{chat.ask.initials}</i><p><b>{chat.ask.name}</b><small>{chat.ask.time}</small></p><p><span class="sd-mention">{chat.ask.mention}</span> {chat.ask.text}</p></div>
                  <div class="sd-msg sd-msg--reply"><i>{chat.reply.initials}</i><p><b>{chat.reply.name}</b><em>{chat.agentTag}</em><small>{chat.reply.time}</small></p><p class="sd-answer">{chat.reply.text}</p><p class="sd-dots" aria-hidden="true"><i></i><i></i><i></i></p></div>
                </div>
              </div>
              <div class="sd-compose">
                <span class="sd-placeholder">{chat.placeholder}</span>
                <span class="sd-typed"><span><span class="sd-mention">{chat.ask.mention}</span> {chat.ask.text}</span></span>
                <i class="sd-send"></i>
              </div>
            </div>
          </div>
        </div>

        <div class="sd-screen" style={place('desk', 1)}>
          <div class="sd-ui sd-ui--light sd-dash">
            <div class="sd-top">
              <b>{dash.app}</b>
              <ul class="sd-nav">{dash.nav.map((item, index) => <li class:list={[index === 0 && 'is-active']}>{item}</li>)}</ul>
              <ul class="sd-ranges">
                {dash.ranges.map((range) => <li>{range}</li>)}
                <svg class="sd-cursor" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 2l14.5 7.2-6.3 1.9-2.3 6.4z" fill="#fff" stroke="#07080A" stroke-width="1.2" stroke-linejoin="round"/></svg>
              </ul>
            </div>
            <div class="sd-kpis">
              {dash.kpis.map((kpi) => (
                <div class:list={[kpi.next && 'sd-kpi--live']}><small>{kpi.label}</small><b><span>{kpi.value}</span>{kpi.next && <span>{kpi.next}</span>}</b></div>
              ))}
            </div>
            <div class="sd-panel sd-chart">
              <p><b>{dash.chart.title}</b><small>{dash.chart.unit}</small></p>
              <div class="sd-bars">{dash.chart.bars.map(([before, after], index) => <div><i style={`--v0:${before};--v1:${after};--i:${index}`}></i><small>{dash.chart.labels[index]}</small></div>)}</div>
            </div>
            <div class="sd-panel sd-feed">
              <p><b>{dash.feed.title}</b></p>
              <div class="sd-rows">
                <ul>
                  {[dash.feed.fresh, ...dash.feed.rows].map((row, index) => <li class:list={[index === 0 && 'sd-fresh']}><i></i><p><b>{row.who}</b><span>{row.what}</span></p><small>{row.time}</small></li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="sd-screen sd-screen--phone" style={place('phone', 2)}>
          <div class="sd-ui sd-app">
            <p class="sd-status"><span>{app.time}</span></p>
            <p class="sd-app-head"><b>{app.title}</b><em class="st">{app.open} <span class="sd-swap">{app.count.map((count) => <span>{count}</span>)}</span></em></p>
            <div class="sd-bill">
              <small>{app.card.ref}</small>
              <b>{app.card.name}</b>
              <strong>{app.card.amount}</strong>
              <dl>{app.card.rows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
              <div class="sd-act">
                <span class="sd-tap is-human">{app.approve}<i></i></span>
                <span class="sd-ok"><i></i>{app.approved}</span>
              </div>
            </div>
            <div class="sd-bill sd-bill--next"><small>{app.next.ref}</small><b>{app.next.name}</b><strong>{app.next.amount}</strong></div>
            <p class="sd-tabs" aria-hidden="true"><i></i><i></i><i></i></p>
          </div>
        </div>

        <div class="sd-screen sd-screen--phone" style={place('phone2', 3)}>
          <div class="sd-ui sd-ui--light sd-lock">
            <p class="sd-clock"><b>{notes.time}</b><small>{notes.date}</small></p>
            <ul class="sd-notes">
              {[notes.fresh, ...notes.items].map((note, index) => <li class:list={[index === 0 && 'sd-fresh']}><small><i></i>{note.app}</small><b>{note.title}</b><span>{note.text}</span></li>)}
            </ul>
          </div>
        </div>

        <div class="sd-screen" style={place('api', 4)}>
          <div class="sd-ui sd-api">
            <p class="sd-api-head"><b>{api.title}</b><small>{api.version}</small><em class="st"><i></i>{api.status}</em></p>
            <div class="sd-net" style={`--hx:${HUB.x};--hy:${HUB.y}`}>
              {NODES.map((node) => <i class:list={['sd-spoke', node.call && `sd-spoke--${node.call}`]} style={spoke(node)}>{node.call && <b></b>}</i>)}
              <div class="sd-node sd-node--hub" style={box(HUB)}><b>{api.hub.name}</b><small>{api.hub.type}</small></div>
              {NODES.map((node) => <div class:list={['sd-node', node.call && `sd-node--${node.call}`]} style={box(node)}><i></i><b>{api.nodes[node.key].name}</b><small>{api.nodes[node.key].type}</small></div>)}
            </div>
            <div class="sd-log">
              <small>{api.log.title}</small>
              {api.log.rows.map((row, index) => <p class:list={[LOG_AFTER[index] && `sd-log--${LOG_AFTER[index]}`]}><b>{row.method}</b><span>{row.path}</span><span>{row.target}</span><span>{row.status}</span><span>{row.time}</span></p>)}
            </div>
          </div>
        </div>

        {wires.map((piece) => <i class="sd-wire" data-wire={piece.name} style={piece.style}><b></b></i>)}
      </div>
    </div>
  </div>
</div>

<script>
  import { softwareDev } from './software-dev.js';

  document.querySelectorAll('[data-mockup="software-dev"]').forEach(softwareDev);
</script>

<style is:global>
.sd{container-type:inline-size}
.sd-frame{--u:1cqw;--move:2.4s;--cam-ease:cubic-bezier(.65,0,.25,1);aspect-ratio:16 / 10;perspective:calc(170 * var(--u));line-height:1.3;box-shadow:0 60px 90px -40px rgba(12,18,48,.42),0 18px 30px -18px rgba(12,18,48,.24)}
.sd-frame.mock-dark{background:var(--stage-gradient)}
.sd-drift{position:absolute;inset:0;z-index:1;transform-style:preserve-3d}
.sd-world{--cam:var(--cam0);position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;transform:var(--cam);transition:transform var(--move) var(--cam-ease)}
.sd[data-shot="chat"] .sd-world{--cam:var(--cam1)}
.sd[data-shot="dash"] .sd-world{--cam:var(--cam2)}
.sd[data-shot="app"] .sd-world{--cam:var(--cam3)}
.sd[data-shot="duo"] .sd-world{--cam:var(--cam4)}
.sd[data-shot="api"] .sd-world{--cam:var(--cam5)}

/* screens: bezel, edge light, reflection; blur and dimming follow --b */
.sd-screen{--b:var(--b0);position:absolute;left:0;top:0;width:calc(var(--w) * var(--u));height:calc(var(--h) * var(--u));margin:calc(var(--h) * var(--u) / -2) 0 0 calc(var(--w) * var(--u) / -2);padding:calc(.7 * var(--u));border-radius:calc(var(--r) * var(--u));background:#08090B;box-shadow:inset 0 0 0 1px rgba(255,255,255,.2),0 calc(4 * var(--u)) calc(9 * var(--u)) rgba(0,0,0,.55);font-size:calc(var(--fs) * var(--u));transform:translate3d(calc(var(--x) * var(--u)), calc((var(--y) + var(--rise, 0)) * var(--u)), calc(var(--z) * var(--u))) rotateY(calc(var(--a) * 1deg));filter:blur(calc(var(--b) * var(--u))) brightness(calc(1 - var(--b) * .65));transition:filter 1.6s ease}
.sd[data-focus="chat"] .sd-screen{--b:var(--b1)}
.sd[data-focus="dash"] .sd-screen{--b:var(--b2)}
.sd[data-focus="app"] .sd-screen{--b:var(--b3)}
.sd[data-focus="duo"] .sd-screen{--b:var(--b4)}
.sd[data-focus="rack"] .sd-screen{--b:var(--b5)}
.sd[data-focus="api"] .sd-screen{--b:var(--b6)}
.sd-ui{position:relative;height:100%;overflow:hidden;border-radius:calc((var(--r) - .7) * var(--u));--m-bg:#111318;--m-fg:#EEF0F6;--m-muted:#8A909B;--m-rule:rgba(238,240,246,.1);--m-soft:rgba(238,240,246,.07);background:var(--m-bg);color:var(--m-fg)}
.sd-ui--light{--m-bg:#fff;--m-fg:var(--fg);--m-muted:var(--muted);--m-rule:var(--rule);--m-soft:rgba(7,8,10,.06)}
.sd-ui::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(118deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,0) 32%)}
.sd-ui small{font-size:.86em;color:var(--m-muted)}
.sd-ui b{font-weight:600}
.sd-ui .st{font-size:.86em;padding:.3em .8em}
.sd-mention{padding:.08em .4em;border-radius:.4em;background:rgba(53,181,140,.16);color:var(--phthalo-lift);font-weight:600}
.sd-swap{display:inline-grid}
.sd-swap span{grid-area:1 / 1;transition:opacity var(--t-fast) ease}
.sd-swap span:first-child{opacity:0}

/* tablet: team chat */
.sd-chat{display:grid;grid-template-columns:11em minmax(0,1fr)}
.sd-rail{display:flex;flex-direction:column;gap:.35em;padding:1.3em 1.1em;background:#0C0D11}
.sd-rail > b{margin-bottom:.9em}
.sd-rail small{margin-top:.6em}
.sd-rail li{padding:.34em .6em;margin:0 -.6em;border-radius:.5em;color:var(--m-muted)}
.sd-rail li::before{content:"# ";opacity:.6}
.sd-rail li.is-active{background:var(--m-soft);color:var(--m-fg)}
.sd-agent{display:flex;align-items:center;gap:.5em}
.sd-agent i,.sd-feed li i,.sd-ok i,.sd-notes small i{width:.5em;height:.5em;border-radius:50%;background:var(--phthalo-lift)}
.sd-room{display:grid;grid-template-rows:auto minmax(0,1fr) auto;min-width:0}
.sd-room-head{display:flex;align-items:baseline;gap:.8em;padding:1.2em 1.5em 1em;border-bottom:1px solid var(--m-rule)}
.sd-room-head b::before{content:"# ";color:var(--m-muted)}
.sd-thread{position:relative;overflow:hidden}
.sd-msgs{--row:5.5em;position:absolute;left:0;right:0;bottom:0;padding:0 1.5em;transition:transform var(--t-move) var(--ease)}
.sd-msg{display:grid;grid-template-columns:2.3em minmax(0,1fr);gap:.1em .8em;align-content:start;height:var(--row);transition:opacity var(--t-move) ease}
.sd-msg > i{grid-row:1 / span 2;display:grid;place-items:center;width:2.9em;height:2.9em;border-radius:50%;background:var(--m-soft);font-style:normal;font-size:.8em;font-weight:600}
.sd-msg > p{grid-column:2}
.sd-msg p:first-of-type{display:flex;align-items:baseline;gap:.6em}
.sd-msg em{font-style:normal;font-size:.8em;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:.15em .5em;border-radius:.4em;background:rgba(53,181,140,.16);color:var(--phthalo-lift)}
.sd-msg--reply > i{background:var(--phthalo);color:#fff}
.sd-answer,.sd-dots{grid-area:2 / 2;transition:opacity var(--t-fast) ease}
.sd-dots{display:flex;gap:.3em;align-items:center;height:1.3em;opacity:0}
.sd-dots i{width:.42em;height:.42em;border-radius:50%;background:var(--m-muted)}
.sd-compose{position:relative;display:flex;align-items:center;height:3.1em;margin:0 1.5em 1.4em;padding:0 1.1em;border-radius:.9em;background:var(--m-soft);white-space:nowrap}
.sd-placeholder{color:var(--m-muted);transition:opacity .2s}
.sd-typed{position:absolute;left:1.1em;overflow:hidden;opacity:0;transform:translateX(-101%)}
.sd-typed > span{display:block;transform:translateX(101%)}
.sd-send{margin-left:auto;width:1.9em;height:1.9em;border-radius:50%;background:var(--m-soft);transition:background-color var(--t-fast)}
.sd[data-chat="0"] .sd-msgs,.sd[data-chat="1"] .sd-msgs{transform:translateY(calc(2 * var(--row)))}
.sd[data-chat="2"] .sd-msgs{transform:translateY(var(--row))}
.sd[data-chat="0"] .sd-msg--ask,.sd[data-chat="1"] .sd-msg--ask,.sd[data-chat="0"] .sd-msg--reply,.sd[data-chat="1"] .sd-msg--reply,.sd[data-chat="2"] .sd-msg--reply{opacity:0;transition:none}
.sd[data-chat="3"] .sd-answer{opacity:0;transition:none}
.sd[data-chat="3"] .sd-dots{opacity:1}
.sd[data-chat="1"] .sd-placeholder{opacity:0}
.sd[data-chat="1"] .sd-typed{opacity:1}
.sd[data-chat="1"] .sd-typed,.sd[data-chat="1"] .sd-typed > span{transform:none;transition:transform 1.2s steps(26)}
.sd[data-chat="1"] .sd-send{background:var(--phthalo-lift)}

/* desktop: dashboard */
.sd-dash{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr);gap:1em;padding:0 1.6em 1.6em;background:#F3F4F8}
.sd-top{grid-column:1 / -1;display:flex;align-items:center;gap:2.4em;height:4.2em;margin:0 -1.6em;padding:0 1.6em;background:#fff}
.sd-top > b{font-size:1.15em;letter-spacing:-.01em}
.sd-nav{display:flex;gap:1.6em;color:var(--m-muted)}
.sd-nav .is-active{color:var(--m-fg);font-weight:600}
.sd-ranges{--on:1;position:relative;display:grid;grid-template-columns:repeat(3,6.4em);margin-left:auto;padding:.25em;border-radius:99px;background:#F0F1F5;text-align:center}
.sd-ranges::before{content:"";position:absolute;left:.25em;top:.25em;bottom:.25em;width:6.4em;border-radius:99px;background:#fff;box-shadow:0 1px 3px rgba(10,14,30,.16);transform:translateX(calc(var(--on) * 100%));transition:transform var(--t-fast) var(--ease)}
.sd-ranges li{position:relative;padding:.38em 0;font-weight:500}

---
import AgentRow from './AgentRow.astro';

const { t } = Astro.props;
const m = t.mockups['managed-agents'];
const labels = JSON.stringify({ status: m.status, approve: m.approve });
---
<div class="ma" data-mockup="managed-agents" data-labels={labels}>
  <div class="device">
    <div class="console mock-dark">
      <div class="mock-bar label"><span>{m.context}</span></div>
      <ul class="agents">
        {m.rows.map((row, index) => <AgentRow row={row} status={m.status} index={index} />)}
      </ul>
      <template data-pool>
        {m.pool.map((row) => <AgentRow row={{ ...row, state: 'plan', progress: 0 }} status={m.status} />)}
      </template>
      <div class="console-foot">
        {Object.entries(m.counters).map(([key, counter]) => (
          <div><small>{counter.label}</small><b data-count={key}>{counter.value}{counter.unit && <span> {counter.unit}</span>}</b></div>
        ))}
      </div>
      <svg class="ma-pointer" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 2l14.5 7.2-6.3 1.9-2.3 6.4z" fill="#fff" stroke="#07080A" stroke-width="1.2" stroke-linejoin="round"/></svg>
    </div>
  </div>
</div>

<script>
  import { managedAgents } from './managed-agents.js';

  document.querySelectorAll('[data-mockup="managed-agents"]').forEach(managedAgents);
</script>

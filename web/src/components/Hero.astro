---
import Panels from './Panels.astro';
import wordmark from '../assets/wordmark-white.svg';

const { t } = Astro.props;
---
<section class="hero" id="top">
  <div class="stage3d stage-dark" data-stage><img class="stage-still" src={wordmark.src} alt={t.header.logoAlt} width="360" height="216"><canvas role="img" aria-label={t.hero.canvasLabel}></canvas><Panels t={t} mode="stage" /></div>
  <div class="marks" aria-hidden="true"><i>+</i><i>+</i><i>+</i><i>+</i></div>
</section>

<script>
  const stage = document.querySelector('[data-stage]');
  const forced = import.meta.env.DEV && location.search.includes('scene=on');
  if (matchMedia('(max-width: 760px)').matches && !forced) document.documentElement.classList.add('is-still');
  else requestAnimationFrame(() => import('../scene/hero.js').then(({ hero }) => hero(stage)));
</script>

<style is:global>
.hero{padding:clamp(20px, 2.4vw, 34px) var(--edge) 0}
.stage3d{height:calc(100svh - clamp(190px, 17vw, 262px));min-height:340px;touch-action:pan-y}
.stage-still{position:absolute;inset:0;margin:auto;width:min(60%, 720px);height:auto;transition:opacity var(--t-fast) var(--ease)}
.js .stage-still{display:none}
.stage3d canvas{position:relative;z-index:1;display:block;width:100%;height:100%;transition:opacity var(--t-move) var(--ease)}
.stage3d:has(.panel:not([hidden])):not([data-flow]) canvas,.stage3d:has(.panel:not([hidden])) .stage-still{opacity:0}
.js .stage3d{opacity:0;transform:scale(.97);transition:opacity var(--t-enter) var(--ease) .35s,transform 1.4s var(--ease) .35s}
.is-ready .stage3d{opacity:1;transform:none}
.marks{display:flex;justify-content:space-between;align-items:center;height:50px;opacity:.32}
.marks i{font-style:normal;font-size:22px;font-weight:300;line-height:1}
@media (max-width:760px){
  .stage3d{height:auto;min-height:0;aspect-ratio:1 / 1}
  .marks i:nth-child(2),.marks i:nth-child(3){display:none}
}
@media (prefers-reduced-motion:reduce){
  .js .stage3d{transition:none;opacity:1;transform:none}
}
</style>

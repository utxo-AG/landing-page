---
import logo from '../assets/wordmark-black.svg';

const { t } = Astro.props;
const m = t.menu;
const number = (i) => String(i + 1).padStart(2, '0');
---
<div class="disclosure" data-disclosure="modal">
  <button class="pill pill--2" type="button" aria-expanded="false" aria-controls="site-menu">{t.header.menu}</button>
  <nav class="panel menu" id="site-menu" aria-label={t.header.menu} hidden>
    <div class="menu-head">
      <img src={logo.src} alt="" width="50" height="30">
      <button class="pill pill--2" type="button" data-close>{t.header.close}</button>
    </div>
    <div class="menu-group">
      <p class="menu-label label">{m.servicesLabel}</p>
      <ol>
        {t.services.map((service, i) => <li><a href={`${t.home}#${service.id}`}><span class="label">{number(i)}</span>{service.name}</a></li>)}
      </ol>
    </div>
    <div class="menu-group">
      <p class="menu-label label">{m.companyLabel}</p>
      <ul class="menu-cols">
        {m.company.map((entry) => <li><a href={entry.href}>{entry.label}</a></li>)}
      </ul>
    </div>
    <div class="menu-group">
      <p class="menu-label label">{m.productsLabel}</p>
      <ul class="menu-cols">
        {m.products.map((entry) => <li><a href={entry.href} target="_blank" rel="noopener">{entry.label}<span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </div>
    <ul class="menu-group menu-legal">
      {m.legal.map((entry) => <li><a href={entry.href}>{entry.label}</a></li>)}
    </ul>
  </nav>
</div>

<style is:global>
.menu{display:grid;gap:6px;width:min(480px, calc(100vw - 2 * var(--edge)));max-height:calc(100svh - 120px);overflow-y:auto;overscroll-behavior:contain;border-radius:16px}
.menu-head{display:none}
.menu-group{background:var(--surface);border-radius:16px;padding:8px;box-shadow:0 1px 2px rgba(0,0,0,.05),0 14px 30px rgba(10,14,30,.1)}
.menu-label{padding:9px 12px 5px;color:var(--muted)}
.menu-group a{display:flex;align-items:baseline;gap:14px;padding:10px 12px;border-radius:10px;font-size:17px;line-height:1.2;letter-spacing:-.01em;transition:background-color var(--t-fast) var(--ease),color var(--t-fast) var(--ease)}
.menu-group a span{color:var(--muted);transition:color var(--t-fast) var(--ease)}
.menu-group a:hover,.menu-group a:focus-visible{background:var(--surface-hover);color:#fff}
.menu-group a:hover span,.menu-group a:focus-visible span{color:rgba(255,255,255,.6)}
.menu-cols{display:grid;grid-template-columns:1fr 1fr}
.menu-cols a{justify-content:space-between}
.menu-legal{display:flex;gap:4px}
.menu-legal a{font-size:14px;color:var(--muted)}

@media (max-width:760px){
  .panel.menu{position:fixed;inset:0;width:auto;max-height:none;border-radius:0;align-content:start;padding:18px var(--edge) 32px;background:var(--bg)}
  .menu-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
  .menu-group{box-shadow:none}
  .is-modal-open{overflow:hidden}
}
</style>

---
import TextPage from '../../layouts/TextPage.astro';
import press from '../../content/press.json';

/* Press page of both languages: outlet logos, coverage list (featured first, the rest behind a toggle), media contact. */
const { t } = Astro.props;
const page = t.pages.presse;
const files = import.meta.glob('../../assets/press/*.{svg,png}', { eager: true, import: 'default' });
const logos = press.logos.map((logo) => ({ ...logo, image: files[`../../assets/press/${logo.file}`] }));
const featured = press.items.filter((item) => item.tier === 'featured');
const more = press.items.filter((item) => item.tier !== 'featured');
const date = (value) => {
  const [year, month] = value.split('-');
  return month ? new Date(Number(year), Number(month) - 1, 1).toLocaleDateString(t.lang, { month: 'short', year: 'numeric' }) : year;
};
const titleLang = (item) => (item.lang === 'DE' ? 'de' : item.lang === 'FR' ? 'fr' : 'en');
---
<TextPage t={t} title={page.title} description={page.description} heading={page.heading} lede={page.lede}>
  <section class="tp-row" data-reveal>
    <h2 class="tp-h tp-rise">{page.logosTitle}</h2>
    <ul class="tp-main pr-logos tp-rise" style="--i:1" aria-label={page.logosLabel}>
      {logos.map((logo) => <li><img class:list={{ 'is-stacked': logo.stacked }} src={logo.image.src} alt={logo.name} width={logo.image.width} height={logo.image.height} loading="lazy" decoding="async"></li>)}
    </ul>
  </section>

  <section class="tp-row" id="coverage" data-reveal>
    <h2 class="tp-h tp-rise">{page.coverageTitle}</h2>
    <div class="tp-main tp-rise" style="--i:1">
      {[featured, more].map((items, group) => {
        const list = (
          <ol class="pr-list">
            {items.map((item) => (
              <li><a href={item.url} target="_blank" rel="noopener">
                <span class="pr-date">{date(item.date)}</span>
                <span class="pr-main"><span class="pr-outlet">{item.outlet}</span>{item.title ? <span class="pr-title" lang={titleLang(item)}>{item.title}</span> : <span class="pr-title">{page.untitled}</span>}</span>
                <span class="pr-entity">{item.entity} <span aria-hidden="true">↗</span></span>
              </a></li>
            ))}
          </ol>
        );
        return group === 0 ? list : <details class="pr-more"><summary><span class="pill pill--2">{page.more.replace('{n}', items.length)}</span></summary>{list}</details>;
      })}
    </div>
  </section>

  <section class="tp-row" id="media-contact" data-reveal>
    <h2 class="tp-h tp-rise">{page.contactTitle}</h2>
    <div class="tp-text tp-rise" style="--i:1">
      <p>{page.contactText}</p>
      <a class="tp-mail tp-link" href={t.contact.mail.href}>{t.contact.mail.note}</a>
    </div>
  </section>
</TextPage>

<style is:global>
.pr-logos{display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(26px, 3vw, 44px) var(--gap);align-items:center}
.pr-logos img{width:auto;height:clamp(20px, 1.9vw, 27px);max-width:min(100%, 170px);object-fit:contain;object-position:left center;filter:grayscale(1);opacity:.72}
.pr-logos img.is-stacked{height:clamp(32px, 3.1vw, 44px)}

.pr-list{border-bottom:1px solid var(--rule)}
.pr-list li{border-top:1px solid var(--rule)}
.pr-list li:first-child{border-top:0}
.tp-main > .pr-list:first-child{margin-top:calc(-1 * clamp(13px, 1.3vw, 19px))}
.pr-list a{display:grid;grid-template-columns:7.2em minmax(0, 1fr) 11.5em;gap:var(--gap);align-items:baseline;padding:clamp(13px, 1.3vw, 19px) 0;transition:opacity var(--t-fast) var(--ease)}
.pr-date,.pr-outlet,.pr-entity{color:var(--muted);font-size:clamp(13px, 1vw, 15px);line-height:1.3}
.pr-outlet{display:block;margin-bottom:4px}
.pr-title{display:block;max-width:34em;font-size:clamp(17px, 1.5vw, 22px);line-height:1.22;letter-spacing:-.02em;text-wrap:pretty}
.pr-entity{text-align:right;white-space:nowrap}
.pr-more > summary{list-style:none;display:inline-block;margin-top:clamp(22px, 2.4vw, 34px);cursor:pointer;border-radius:99px}
.pr-more > summary::-webkit-details-marker{display:none}
.pr-more[open] > summary{display:none}
.pr-more .pr-list li:first-child{border-top:0}
@media (hover:hover){
  .pr-list:hover a{opacity:.32}
  .pr-list a:hover{opacity:1}
}
@media (max-width:760px){
  .pr-logos{grid-template-columns:repeat(3,1fr)}
  .pr-list a{grid-template-columns:auto minmax(0, 1fr);gap:6px 12px}
  .pr-main{grid-column:1 / -1;grid-row:2}
  .pr-outlet{margin-bottom:5px}
  .pr-entity{grid-column:2;grid-row:1}
}
</style>

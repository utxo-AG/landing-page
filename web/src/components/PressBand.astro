---
/* Press band: the pill "In der Presse" (link to the press page) and a marquee of the outlets from content/press.json. Sits between the closing stage and the footer. */
import LogoLine from './LogoLine.astro';
import press from '../content/press.json';

const { t } = Astro.props;
const p = t.references.press;
const files = import.meta.glob('../assets/press/*.{svg,webp,png}', { eager: true, import: 'default' });
const STACKED = 1.6;
const logos = press.logos.map((entry) => ({ ...entry, image: files[`../assets/press/${entry.file}`], scale: entry.stacked ? STACKED : 1 }));
---
<section class="press-band" data-press-band>
  <div class="press-band-line">
    <LogoLine label={p.label} logos={logos} tone="grey" seconds={90}>
      <a class="pill pill--talk" href={p.link.href}>{p.link.text} <i></i></a>
    </LogoLine>
  </div>
</section>

<script>
  import { register } from '../motion/loop.js';

  document.querySelectorAll('[data-press-band]').forEach((section) => register(section));
</script>

<style is:global>
.press-band{padding:clamp(72px, 8vw, 128px) var(--edge) clamp(36px, 4.4vw, 72px)}
/* one line: the link pill on the left, the marquee beside it; the text label of LogoLine is not shown here */
.press-band .refs-line{grid-template-columns:auto minmax(0,1fr);column-gap:clamp(28px, 3.4vw, 56px)}
.press-band .refs-line .refs-line-label{display:none}
.press-band .refs-line > a{grid-column:1;grid-row:1;align-self:center;margin:0}
.press-band .refs-line .refs-marquee{grid-column:2;grid-row:1;align-self:center;margin:0}
@media (max-width:900px){
  .press-band .refs-line{display:grid;grid-template-columns:1fr;row-gap:22px}
  .press-band .refs-line > a{justify-self:start}
  .press-band .refs-line .refs-marquee{grid-column:1;grid-row:2}
}
.js .press-band-line{opacity:0;transform:translateY(22px);transition:opacity var(--t-move) ease,transform var(--t-enter) var(--ease)}
.js .is-in .press-band-line{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .js .press-band-line{opacity:1;transform:none;transition:none}
}
</style>

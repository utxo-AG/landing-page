---
import serviceplan from '../assets/logos/serviceplan.svg';
import LogoLine from './LogoLine.astro';
import sokosumiClients from '../content/sokosumi-clients.json';
import nmkrClients from '../content/nmkr-clients.json';
import { formatNumber } from '../page/format.js';

const { t } = Astro.props;
const r = t.references;
/* the Serviceplan lead block only speaks for the rows right under it; own brands (row.own) follow as a separate list */
const groups = [r.rows.filter((row) => !row.own), r.rows.filter((row) => row.own)].filter((group) => group.length);
const files = import.meta.glob('../assets/{logos,sokosumi-clients,nmkr-clients}/*.{svg,webp,png}', { eager: true, import: 'default' });
const logos = (folder, list) => list.map((entry) => ({ ...entry, image: files[`../assets/${folder}/${entry.file}`] }));
const clients = {
  sokosumi: { logos: logos('sokosumi-clients', sokosumiClients), seconds: 48 },
  nmkr: { logos: logos('nmkr-clients', nmkrClients), seconds: 56, reverse: true },
};
---
<section class="refs" id={r.id} data-refs data-number={JSON.stringify(t.number)}>
  <h2 class="display"><span class="ln"><span>{r.title}</span></span></h2>
  <div class="refs-lead refs-item" style="--i:0">
    <img class="refs-sp" src={serviceplan.src} alt={r.lead.name} width="2119" height="218" loading="lazy">
    <div class="refs-lead-text">
      <p class="refs-claim">{r.lead.claim}</p>
      <p class="refs-note">{r.lead.text}</p>
    </div>
  </div>
  {groups.map((group, g) => (
    <Fragment>
    {g > 0 && group[0].tag && <p class="refs-own-label label refs-item" style={`--i:${r.rows.indexOf(group[0]) + 1}`}>{group[0].tag}</p>}
    <ul class:list={['refs-list', { 'refs-list--own': g > 0 }]}>
      {group.map((row) => (
        <li class:list={['refs-item', { 'refs-row--inline': clients[row.clients] && row.figures.length > 1 }]} style={`--i:${r.rows.indexOf(row) + 1}`}>
          <a href={row.href} target="_blank" rel="noopener">
            <span class="refs-name"><img class="refs-logo" src={files[`../assets/logos/${row.logo}`].src} alt={row.name} width={files[`../assets/logos/${row.logo}`].width} height={files[`../assets/logos/${row.logo}`].height} loading="lazy"></span>
            <span class="refs-desc">{row.text}</span>
            <span class="refs-figs">
              {row.figures.map((figure) => (
                <span class="refs-fig">
                  {figure.text
                    ? <b>{figure.text}</b>
                    : <b><span data-count={figure.value} data-decimals={figure.decimals ?? 0}>{formatNumber(figure.value, t.number, figure.decimals)}</span>{figure.suffix}</b>}
                  {figure.label && <small>{figure.label}</small>}
                </span>
              ))}
            </span>
          </a>
          {clients[row.clients] && <LogoLine label={row.clientsLabel} {...clients[row.clients]} />}
        </li>
      ))}
    </ul>
    </Fragment>
  ))}
</section>

<script>
  import { register } from '../motion/loop.js';
  import { formatNumber } from '../page/format.js';

  const COUNT_FROM = 0.4;
  const COUNT_FOR = 1.6;

  document.querySelectorAll('[data-refs]').forEach((section) => {
    const separators = JSON.parse(section.dataset.number);
    const figures = [...section.querySelectorAll('[data-count]')].map((el) => ({ el, value: Number(el.dataset.count), decimals: Number(el.dataset.decimals) }));
    const show = (k) => figures.forEach(({ el, value, decimals }) => { el.textContent = formatNumber(value * k, separators, decimals); });
    let done = false;
    register(section, {
      enter: COUNT_FROM + COUNT_FOR,
      tick(t) {
        if (done) return;
        const k = Math.min(1, Math.max(0, (t + COUNT_FOR) / COUNT_FOR));
        show(1 - Math.pow(1 - k, 3));
        done = k === 1;
      },
      reset() { done = false; show(1); },
    });
  });
</script>

<style is:global>
.refs{padding:clamp(96px, 14vw, 210px) var(--edge) 0}
.refs-lead{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--gap);align-items:center;margin-top:clamp(40px, 5vw, 80px);padding-bottom:clamp(36px, 4.4vw, 70px)}
.refs-sp{grid-column:1 / span 8;justify-self:center;width:50%;height:auto}
.refs-lead-text{grid-column:9 / -1}
.refs-claim{font-size:clamp(19px, 1.7vw, 26px);line-height:1.15;letter-spacing:-.03em}
.refs-note{margin-top:.7em;color:var(--muted);font-size:clamp(14px, 1.2vw, 17.5px);line-height:1.35}
.refs-list{border-bottom:1px solid var(--rule)}
.refs-own-label{margin-top:clamp(56px, 7vw, 112px);margin-bottom:16px;color:var(--muted)}
.refs-own-label + .refs-list--own{margin-top:0}
.refs-list--own{margin-top:clamp(56px, 7vw, 112px)}
.refs-list > li{border-top:1px solid var(--rule)}
.refs-list a{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--gap);align-items:baseline;padding:clamp(18px, 1.8vw, 28px) 0;transition:opacity var(--t-fast) var(--ease)}
.refs-name{grid-column:1 / span 3;align-self:start;display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;font-size:clamp(21px, 2.2vw, 34px);line-height:1.05;letter-spacing:-.035em}
.refs-logo{width:auto;height:clamp(18px, 1.75vw, 27px)}
.refs-desc{grid-column:4 / span 4;color:var(--muted);font-size:clamp(14px, 1.2vw, 17.5px);line-height:1.35}
.refs-figs{grid-column:8 / -1;display:grid;grid-template-columns:40% minmax(0,1fr);gap:14px var(--gap);align-items:center}
.refs-fig{display:contents}
.refs-fig b{justify-self:end;text-align:right;font-size:clamp(21px, 2.2vw, 34px);font-weight:400;line-height:1.05;letter-spacing:-.035em;white-space:nowrap;font-variant-numeric:lining-nums}
.refs-fig small{color:var(--muted);font-size:clamp(13px, 1.05vw, 15.5px);line-height:1.3}
.refs-list .refs-line{padding-bottom:clamp(18px, 1.8vw, 28px)}
/* a row with several figures is tall enough to carry its logo line inside: label bottom left, a narrow marquee under the description */
.refs-row--inline{display:grid}
.refs-row--inline > a,.refs-row--inline > .refs-line{grid-area:1 / 1}
.refs-row--inline > .refs-line{align-self:end;pointer-events:none}
.refs-row--inline .refs-marquee{grid-column:4 / span 3}
.js .refs-item{opacity:0;transform:translateY(22px);transition:opacity var(--t-move) ease,transform var(--t-enter) var(--ease);transition-delay:calc(120ms + var(--i) * var(--stagger))}
.js .is-in .refs-item{opacity:1;transform:none}
@media (hover:hover){
  .refs-list:has(a:hover) a{opacity:.32}
  .refs-list:has(a:hover) a:hover{opacity:1}
}
@media (max-width:900px){
  .refs-row--inline{display:block}
  .refs-lead{display:block}
  .refs-lead-text{margin-top:26px}
  .refs-list a{display:block}
  .refs-desc{display:block;margin-top:10px;max-width:34em}
  .refs-figs{margin-top:18px}
  .refs-figs{grid-template-columns:auto minmax(0,1fr);column-gap:14px}
}
@media (prefers-reduced-motion:reduce){
  .js .refs-item{opacity:1;transform:none;transition:none}
}
</style>

---
/*
  Consent banner for Google Analytics 4 (Consent Mode v2). Equal-weight Decline / Accept, choice kept
  12 months in localStorage.utxo_consent, gtag.js loads only after Accept, ad signals always denied.
  [data-consent-open] anywhere on the page reopens the banner. Empty measurement id: everything is off.
*/
const { t } = Astro.props;
const c = t.consent;
---
<div class="consent" role="dialog" aria-label={c.label} data-consent={t.analytics.gaMeasurementId} hidden>
  <p>{c.text} <a href={c.privacyHref}>{c.privacy}</a></p>
  <div class="consent-actions">
    <button class="pill pill--2" type="button" data-consent-set="denied">{c.deny}</button>
    <button class="pill pill--2" type="button" data-consent-set="granted">{c.accept}</button>
  </div>
</div>

<script>
  import { consent } from '../page/consent.js';

  consent(document.querySelector('[data-consent]'));
</script>

<style is:global>
.consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:20;max-width:520px;margin-left:auto;display:grid;gap:16px;padding:20px 22px;border-radius:16px;background:var(--surface);box-shadow:0 1px 2px rgba(0,0,0,.05),0 24px 60px -24px rgba(10,14,30,.35)}
.consent[hidden]{display:none}
.consent p{font-size:14px;line-height:1.5;color:var(--muted)}
.consent a{color:var(--fg);text-decoration:underline;text-underline-offset:2px}
.consent-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.consent-actions .pill{justify-content:center;transition:background-color var(--t-fast) var(--ease),color var(--t-fast) var(--ease)}
.consent-actions .pill:hover{background:var(--surface-hover);color:#fff}
</style>

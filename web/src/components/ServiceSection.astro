---
/*
  One service: headline (the service name), one mockup (default slot), one copy block.
  The mockup's script registers this section ([data-section]) with motion/loop.js,
  so headline, mockup and copy share one .is-in.
  layout:
    "mockup-left"   mockup columns 1 to 7, copy 9 to 12
    "mockup-right"  copy columns 1 to 3, mockup 5 to 12
    "wide"          copy first, mockup across the full width below
    "stage"         full-width dark stage; the mockup fills it, headline and copy sit on it, bottom left
                    (up to 900px: headline above the stage, stage 4:5, copy below)
*/
const { service, layout } = Astro.props;
---
<section class:list={['svc', `svc--${layout}`]} id={service.id} data-section>
  {layout === 'stage' ? (
    <Fragment>
      <div class="svc-stage stage-dark">
        <div class="svc-mockup" role="img" aria-label={service.mockupLabel}><slot /></div>
      </div>
      <div class="svc-stage-text">
        <h2 class="display"><span class="ln"><span>{service.name}</span></span></h2>
        <div class="svc-copy"><p class="body">{service.body}</p></div>
      </div>
    </Fragment>
  ) : (
    <Fragment>
      <h2 class="display"><span class="ln"><span>{service.name}</span></span></h2>
      <div class="svc-grid">
        <div class="svc-mockup" role="img" aria-label={service.mockupLabel}><slot /></div>
        <div class="svc-copy"><p class="body">{service.body}</p></div>
      </div>
    </Fragment>
  )}
</section>

<style is:global>
.svc{overflow-x:clip;padding:clamp(96px, 14vw, 210px) var(--edge) 0}
.svc-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--gap);margin-top:clamp(40px, 5vw, 80px);align-items:center}
.svc--mockup-left .svc-mockup{grid-column:1 / span 7}
.svc--mockup-left .svc-copy{grid-column:9 / -1}
.svc--mockup-right .svc-mockup{grid-column:5 / -1;grid-row:1}
.svc--mockup-right .svc-copy{grid-column:1 / span 3;grid-row:1}
.svc--wide .svc-mockup{grid-column:1 / -1;grid-row:2}
.svc--wide .svc-copy{grid-column:1 / span 6;grid-row:1;margin-bottom:clamp(28px, 3.4vw, 56px)}
.svc--stage{display:grid}
/* a mockup sets the stage size from its own CSS: .svc-stage:has(.<prefix>){--stage-h:…;--stage-ratio:…} */
.svc--stage .svc-stage{grid-area:1 / 1;display:grid;min-height:var(--stage-h, min(110svh, 1100px))}
.svc--stage .svc-mockup{display:grid;position:relative;z-index:1}
.svc--stage .svc-stage-text{grid-area:1 / 1;z-index:1;align-self:end;justify-self:start;width:50%;padding:clamp(22px, 3.4vw, 54px);color:var(--stage-fg);pointer-events:none}
.svc--stage .display{font-size:clamp(30px, 3.8vw, 60px)}
.svc--stage .svc-copy{margin-top:clamp(14px, 1.6vw, 24px);color:var(--stage-muted)}
.js .svc-copy{opacity:0;transform:translateY(20px);transition:opacity var(--t-enter) ease .5s,transform var(--t-enter) var(--ease) .5s}
.js .is-in .svc-copy{opacity:1;transform:none}
/* below 1000px the copy has no room beside a mockup */
@media (max-width:1000px){
  .svc-grid{display:flex;flex-direction:column;align-items:stretch;gap:0}
  .svc-copy{padding-top:34px}
  .svc--wide .svc-copy{order:-1;padding-top:0}
}
@media (max-width:900px){
  .svc--stage .svc-stage{grid-area:2 / 1;min-height:0;aspect-ratio:var(--stage-ratio, 4 / 5)}
  .svc--stage .svc-stage-text{display:contents;color:inherit}
  .svc--stage .display{grid-area:1 / 1;margin-bottom:clamp(28px, 5vw, 44px);font-size:var(--fs-display)}
  .svc--stage .svc-copy{grid-area:3 / 1;padding-top:34px;color:inherit}
}
@media (prefers-reduced-motion:reduce){
  .js .svc-copy{transition:none;opacity:1;transform:none}
}
</style>

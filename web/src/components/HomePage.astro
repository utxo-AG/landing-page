---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Overview from './Overview.astro';
import ServiceSection from './ServiceSection.astro';
import ManagedAgents from './mockups/ManagedAgents.astro';

const { t } = Astro.props;
const service = (id) => t.services.find((entry) => entry.id === id);
---
<Base t={t}>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Overview t={t} />
    <ServiceSection service={service('managed-agents')} layout="mockup-left">
      <ManagedAgents t={t} />
    </ServiceSection>
  </main>
</Base>

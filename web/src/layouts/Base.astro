---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/mockup.css';
import fontUrl from '../assets/fonts/manrope-latin-var.woff2?url';
import iconSvg from '../assets/icons/icon.svg?url';
import iconPng from '../assets/icons/favicon-96x96.png?url';
import iconTouch from '../assets/icons/apple-touch-icon-180x180.png?url';
import { alternates, defaultLanguage } from '../i18n/routes.js';

/*
  title, description: text pages override the home defaults from the dictionary. schema: extra JSON-LD nodes of the page.
  The site is noindex unless it is built with PUBLIC_INDEXABLE=1 (set in the Dockerfile for production).
  The email_off comments stop Cloudflare from rewriting e-mail addresses in the HTML (it replaces them with a
  placeholder that a script fills in later, which changes text the header panels measure).
*/
const { t, title = t.meta.title, description = t.meta.description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const indexable = import.meta.env.PUBLIC_INDEXABLE === '1';
const versions = alternates(Astro.url.pathname);
const absolute = (path) => new URL(path, Astro.site).href;
const shareImage = absolute(`/og/og-${t.lang}.png`);
/* Structured data: Organization and WebSite on every page, WebPage for this page, plus whatever the page passes in `schema` (e.g. Service, BreadcrumbList). */
const graph = [
  {
    '@type': 'Organization',
    '@id': 'https://utxo.ag/#org',
    name: 'utxo AG',
    url: 'https://utxo.ag/',
    logo: absolute('/logo-512.png'),
    email: 'business@utxo.ag',
    foundingDate: '2022-02',
    address: { '@type': 'PostalAddress', streetAddress: 'Dammstrasse 16', postalCode: '6300', addressLocality: 'Zug', addressCountry: 'CH' },
    areaServed: ['CH', 'DE', 'AT'],
    brand: { '@type': 'Brand', name: 'NMKR', url: 'https://www.nmkr.io' },
    hasOfferCatalog: { '@type': 'OfferCatalog', name: t.overview.label, itemListElement: t.services.map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.name, description: service.short } })) },
  },
  { '@type': 'WebSite', '@id': 'https://utxo.ag/#website', url: 'https://utxo.ag/', name: 'utxo AG', publisher: { '@id': 'https://utxo.ag/#org' }, inLanguage: ['de', 'en'] },
  { '@type': 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description, inLanguage: t.lang, isPartOf: { '@id': 'https://utxo.ag/#website' }, about: { '@id': 'https://utxo.ag/#org' }, primaryImageOfPage: shareImage },
  ...schema,
];
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{!indexable && <meta name="robots" content="noindex">}
<link rel="canonical" href={canonical}>
{versions && Object.entries(versions).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={absolute(path)}>)}
{versions && <link rel="alternate" hreflang="x-default" href={absolute(versions[defaultLanguage])}>}
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="utxo AG">
<meta property="og:locale" content={t.locale}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={shareImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={shareImage}>
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}></script>
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin>
<link rel="icon" href={iconSvg} type="image/svg+xml">
<link rel="icon" href={iconPng} sizes="96x96" type="image/png">
<link rel="apple-touch-icon" href={iconTouch}>
<script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
<!--email_off-->
<a class="skip" href="#main">{t.skip}</a>
<slot />
<script>
  import { backdrop } from '../page/backdrop.js';
  import { disclosures } from '../page/disclosure.js';

  backdrop();
  document.querySelectorAll('[data-set-lang]').forEach((link) => link.addEventListener('click', () => {
    document.cookie = `utxo_lang=${link.dataset.setLang};path=/;max-age=31536000;samesite=lax`;
  }));
  disclosures();
  document.documentElement.classList.add('is-ready');
</script>
<!--/email_off-->
</body>
</html>

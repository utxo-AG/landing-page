---
import TextPage from '../layouts/TextPage.astro';
import t from '../i18n/de/index.js';
import en from '../i18n/en/index.js';

const n = t.notFound;
---
<TextPage t={t} title={n.title} description={n.description} heading={n.heading} lede={n.lede}>
  <p class="nf"><a class="pill pill--talk" href={t.home}>{n.back}</a> <a class="pill pill--2" href={en.home} lang={en.lang} hreflang={en.lang}>{en.notFound.back}</a></p>
</TextPage>

<style is:global>
.nf{padding:0 var(--edge) clamp(96px, 14vw, 210px)}
</style>

---
/* Development page for one mockup in isolation. Not linked; the dev folder is removed before cutover. */
import Base from '../../layouts/Base.astro';
import ServiceSection from '../../components/ServiceSection.astro';
import SoftwareDev from '../../components/mockups/SoftwareDev.astro';
import t from '../../i18n/de/index.js';

const service = t.services.find((entry) => entry.id === 'software-development');
---
<Base t={t}>
  <main>
    <ServiceSection service={service} layout="mockup-right">
      <SoftwareDev t={t} />
    </ServiceSection>
  </main>
</Base>

---
/* Development page for one mockup in isolation. Not linked; the dev folder is removed before cutover. */
import Base from '../../layouts/Base.astro';
import ServiceSection from '../../components/ServiceSection.astro';
import ManagedAgents from '../../components/mockups/ManagedAgents.astro';
import t from '../../i18n/de/index.js';

const service = t.services.find((entry) => entry.id === 'managed-agents');
---
<Base t={t}>
  <main>
    <ServiceSection service={service} layout="mockup-left">
      <ManagedAgents t={t} />
    </ServiceSection>
  </main>
</Base>

---
/* Development page for one mockup in isolation. Not linked; the dev folder is removed before cutover. */
import Base from '../../layouts/Base.astro';
import ServiceSection from '../../components/ServiceSection.astro';
import Automation from '../../components/mockups/Automation.astro';
import t from '../../i18n/de/index.js';

const service = t.services.find((entry) => entry.id === 'ki-automationen');
---
<Base t={t}>
  <main>
    <ServiceSection service={service} layout="stage">
      <Automation t={t} />
    </ServiceSection>
  </main>
</Base>

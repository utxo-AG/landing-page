---
import ArticlePage from '../../../components/pages/ArticlePage.astro';
import t from '../../../i18n/de/index.js';
import { published } from '../../../content/articles.js';

export function getStaticPaths() {
  return published('de').map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
---
<ArticlePage t={t} article={article} />
